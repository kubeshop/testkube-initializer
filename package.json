{
  "name": "testkube-initializer",
  "private": true,
  "version": "2.12.1",
  "type": "module",
  "description": "Frontend wizard to generate Helm values.yaml for deploying Testkube (OSS & Enterprise).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "extract-tips": "node scripts/extract-tips.mjs",
    "docker:build": "docker build -t testkube-initializer:latest .",
    "docker:run": "docker run --rm -p 8080:80 testkube-initializer:latest"
  },
  "dependencies": {
    "posthog-js": "^1.390.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^6.0.0"
  }
}
